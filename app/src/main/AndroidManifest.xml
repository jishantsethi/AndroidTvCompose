<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Streaming catalogue + posters are fetched over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        THE FOUR LINES THAT MAKE THIS A TV APP
        ======================================

        1. android.software.leanback
           Declares "this app has a TV (leanback) UI". Play Store uses it to
           decide whether the app is eligible for the Android TV catalogue.

           NOTE the required="false". A strict TV-only app sets this to *true*.
           We keep it false on purpose so the very same APK also installs and
           runs on a phone/tablet emulator — handy while developing, because a
           TV system image is a ~1.5 GB download. Flip both of these to the
           commented values when you ship TV-only.

        2. android.hardware.touchscreen required="false"
           MANDATORY for TV. Every Android app implicitly requires a
           touchscreen; TV devices do not have one. Forget this line and the
           Play Store will simply not offer your app on TV.

        3. LEANBACK_LAUNCHER category (below, on the activity)
           This is what puts the app tile on the Android TV home screen.
           A plain android.intent.category.LAUNCHER does NOT appear there.

        4. android:banner
           The 320x180 artwork drawn on the TV home row. Required for any
           activity carrying LEANBACK_LAUNCHER; the build fails lint without it.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />           <!-- TV-only build: true -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />           <!-- always false for TV -->

    <application
        android:allowBackup="true"
        android:name=".TvApplication"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.AndroidTvCompose">

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.AndroidTvCompose">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Puts the tile on the Android TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!-- Handset launcher too, so we can test on a phone emulator. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
