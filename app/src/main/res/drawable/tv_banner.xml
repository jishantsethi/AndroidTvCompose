<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV home-screen banner. Must be 320x180 (xhdpi). Referenced from
    AndroidManifest via android:banner; a LEANBACK_LAUNCHER activity without one
    fails lint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0" android:startY="0"
                android:endX="320" android:endY="180"
                android:type="linear">
                <item android:offset="0" android:color="#FF1A2340" />
                <item android:offset="1" android:color="#FF0B0D12" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Accent rail, echoing the focused-row rail used inside the app. -->
    <path android:pathData="M0,0h8v180h-8z" android:fillColor="#FF4F8DFD" />

    <!-- Play glyph, centred. -->
    <path android:pathData="M138,60 L200,90 L138,120 Z" android:fillColor="#FF4F8DFD" />
</vector>
